# Supabase (Project Settings -> API). Service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared team PIN for editing, plus a long random secret for signing the unlock cookie.
TEAM_PIN=
COOKIE_SECRET=

# Vercel Cron sends this as a Bearer token to /api/cron/reminders.
CRON_SECRET=

# Web Push keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
